PORT=3001
NODE_ENV=development
META_GRAPH_API=https://graph.facebook.com/v21.0

# Local Vite → Express only (ignored in production builds; production always uses same-origin /api/*)
# Do NOT set VITE_API_BASE_URL in Cloudflare Pages.
VITE_API_BASE_URL=http://localhost:3001

# Local Express defaults stay locked for safety.
# Cloudflare Pages production is set via wrangler.toml [vars]:
#   META_APP_MODE=live
#   META_PRIVACY_POLICY_CONFIGURED=true
META_APP_MODE=development
META_PRIVACY_POLICY_CONFIGURED=false
