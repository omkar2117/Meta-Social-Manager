PORT=3001
NODE_ENV=development
META_GRAPH_API=https://graph.facebook.com/v21.0

# Local Vite → Express only (ignored in production builds; production always uses same-origin /api/*)
VITE_API_BASE_URL=http://localhost:3001

# Cloudflare Pages / production env (do NOT set VITE_API_BASE_URL in Cloudflare build):
# META_APP_MODE=development
# META_PRIVACY_POLICY_CONFIGURED=false
# Unlock Create Boost only after Meta App is Live AND Privacy Policy URL is configured:
# META_APP_MODE=live
# META_PRIVACY_POLICY_CONFIGURED=true
META_APP_MODE=development
META_PRIVACY_POLICY_CONFIGURED=false
